# apps/edge — these are Cloudflare Worker secrets, not a runtime .env file.
# Set each one with:
#   wrangler secret put <NAME>
# and, for local `wrangler dev`, copy this file to `.dev.vars` (gitignored).
# Every value below is a placeholder. Never commit a real secret.

# Hyperdrive config id. Not a secret, but environment-specific — paste it into
# the `id` field of the [[hyperdrive]] block in wrangler.toml.
HYPERDRIVE_ID=replace-with-the-id-from-wrangler-hyperdrive-create

# Supabase project JWT secret (Dashboard > Project Settings > API > JWT Secret).
SUPABASE_JWT_SECRET=replace-me

# Base URL of the compute service on Fly.
COMPUTE_API_URL=https://starkcontrols-compute.fly.dev

# Shared HMAC secret; must match apps/compute's COMPUTE_API_KEY exactly.
COMPUTE_API_KEY=replace-me-with-a-32-byte-random-hex-string
