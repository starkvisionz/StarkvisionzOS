# apps/web — copy to .env.local for local dev; set the same names in Vercel.
# NEXT_PUBLIC_* values are inlined into the browser bundle: only ever put
# publishable values here. Every value below is a placeholder.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-the-anon-publishable-key
NEXT_PUBLIC_API_BASE=https://starkcontrols-edge.YOUR_SUBDOMAIN.workers.dev
