# apps/compute — copy to .env for local dev, or set as Fly secrets.
#   fly secrets set KEY=value --app starkcontrols-compute
# Every value below is a placeholder. Never commit a real secret.

# Supabase transaction pooler connection string (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Shared HMAC secret; must match the Worker's COMPUTE_API_KEY exactly.
COMPUTE_API_KEY=replace-me-with-a-32-byte-random-hex-string

# Cloudflare R2 (S3-compatible) credentials for the starkcontrols-files bucket.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Registered for later sessions; unused by the code in Session 01.
ANTHROPIC_API_KEY=sk-ant-replace-me
