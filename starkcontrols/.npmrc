# eslint-config-next pulls its plugins in transitively, and pnpm's strict
# node_modules layout hides them from ESLint's resolver. Hoisting eslint
# packages to the workspace root is the supported fix.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/eslint-plugin-next

# Never let a postinstall script phone home for a browser we already ship.
strict-peer-dependencies=false
