# ---------------------------------------------------------------------------
# GitHub Actions environment registry — every name a workflow in this repo can
# consume, in one file.
#
#   cp .env.github.example .env.github     # .env.github is gitignored
#   $EDITOR .env.github                    # fill in real values
#   scripts/sync-github-env.sh .env.github
#
# The script classifies each name as an encrypted Actions *secret* or a plain
# Actions *variable* (see ENVIRONMENT.md for the full table) and refuses to
# upload anything that still looks like a placeholder. Leave a name blank to
# skip it.
#
# Do not put inline `# comments` after a value — the whole line is the value.
# ---------------------------------------------------------------------------


# ── StarkControls · Supabase ────────────────────────────────────────────────
# Transaction pooler (port 6543). Consumed by apps/compute and Hyperdrive.
DATABASE_URL=
# Session pooler (port 5432). Migrations only.
DIRECT_URL=
# Dashboard > Project Settings > API > JWT Secret. Verifies end-user tokens.
SUPABASE_JWT_SECRET=

# ── StarkControls · service-to-service ──────────────────────────────────────
# One 32-byte hex value shared by apps/edge and apps/compute: openssl rand -hex 32
COMPUTE_API_KEY=
# Public base URL of the compute service on Fly.
COMPUTE_API_URL=

# ── StarkControls · Cloudflare ──────────────────────────────────────────────
# Hyperdrive config id from `wrangler hyperdrive create` (account-scoped, not secret).
HYPERDRIVE_ID=
# R2 API token scoped to starkcontrols-files, Object Read.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Needed only if a workflow runs `wrangler deploy` for you.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── StarkControls · web (inlined into the browser bundle at build time) ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── StarkvisionzOS root app (Vite + Express) ────────────────────────────────
# Shared bearer token protecting /api. Set this for any non-local deployment.
SVOS_AUTH_TOKEN=
SVOS_ACTOR=operator
SVOS_ALLOWED_ORIGINS=
SVOS_MAX_PROMPT_CHARS=24000
SVOS_MAX_OUTPUT_TOKENS=8192
SVOS_RATE_LIMIT=30
SVOS_CHAT_LIMIT=10
SVOS_RATE_WINDOW_MS=60000
PORT=8787

# ── Hostinger deployment ────────────────────────────────────────────────────
# Fill in the group that matches your plan and leave the other blank.
#
# Shared / Premium / Business hosting — static upload over FTP:
HOSTINGER_FTP_HOST=
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
# Target directory on the host, e.g. /public_html or /domains/example.com/public_html
HOSTINGER_FTP_PATH=
#
# VPS — build locally, ship over SSH, run with Node:
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_USER=
HOSTINGER_SSH_PORT=22
# The full private key, including the BEGIN/END lines.
HOSTINGER_SSH_KEY=
HOSTINGER_DEPLOY_PATH=
