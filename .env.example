# Starkvisionz OS — backend configuration
#
# The chat backend calls the Anthropic API. Provide a key to enable real,
# streaming Claude responses. Without it, the app still runs — chat replies
# with a clear "no API key configured" message instead of calling the model.
ANTHROPIC_API_KEY=

# Optional: port for the API server (default 8787). The Vite dev server proxies
# /api to this port.
PORT=8787

# Optional: where the SQLite event store lives (default server/data/svos.db).
# SVOS_DB_PATH=server/data/svos.db
