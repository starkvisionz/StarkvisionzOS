# Starkvisionz OS — backend configuration

# ── Anthropic ──
# The chat backend calls the Anthropic API. Provide a key to enable real,
# streaming Claude responses. Without it the app still runs — chat replies with
# a clear "no API key configured" message instead of calling the model.
ANTHROPIC_API_KEY=

# ── Auth (IMPORTANT for any non-local deployment) ──
# Shared bearer token protecting the API. When set, every /api request (except
# /api/health) requires `Authorization: Bearer <token>`; the browser client
# prompts for it once and stores it locally. When UNSET, the API only serves
# loopback requests and refuses remote callers — so an unconfigured public
# deployment is closed by default, not wide open. SET THIS before exposing the
# server to a network.
SVOS_AUTH_TOKEN=

# Name recorded as the actor on human-initiated events (defaults to "operator").
SVOS_ACTOR=operator

# Comma-separated list of origins allowed for cross-origin (CORS) requests.
# Empty = no CORS (same-origin only). Only needed if the web app is served from
# a different origin than the API.
SVOS_ALLOWED_ORIGINS=

# ── Limits / budgets ──
SVOS_MAX_PROMPT_CHARS=24000   # reject prompts longer than this
SVOS_MAX_OUTPUT_TOKENS=8192   # per-reply max_tokens ceiling
SVOS_RATE_LIMIT=30            # general /api requests per window
SVOS_CHAT_LIMIT=10            # chat turns per window
SVOS_RATE_WINDOW_MS=60000     # rate-limit window

# ── Server ──
PORT=8787                     # Vite dev server proxies /api here
# SVOS_DB_PATH=server/data/svos.db   # SQLite event store location
# SVOS_REBUILD_ON_START=1            # rebuild projections from the event log at boot
